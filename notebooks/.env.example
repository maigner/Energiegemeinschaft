# Zugangsdaten fuer notebooks/energyData/eegfaktura_import.py
# (Kopie als notebooks/.env, ist gitignoriert). Normale EEG-Faktura-Anmeldung,
# kein eigener API-Schluessel. Das Passwort darf keinen Doppelpunkt enthalten.
FAKTURA_USER=vorname.nachname@example.org
FAKTURA_PASSWORD=
RC_NUMBER=RC101533
# Gemeinschafts-ID (33 Zeichen), steht in EEG-Faktura unter Stammdaten
# und im Energy-Report auf dem Blatt Summary
EC_ID=AT00300000000RC101533000000968701
# optional:
# FAKTURA_BASE_URL=https://eegfaktura.at/energystore
# EEG_DB_DSN=service=eeg-middleware
