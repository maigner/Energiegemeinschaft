# ============================================================================
# Konfiguration fuer das ISCHLSTROM Batteriemanagement (IBM)
#
# Normalerweise nicht von Hand anlegen - der Assistent erzeugt diese Datei:
#   sudo ./00-wizard.sh
#
# Diese Vorlage dient als Referenz und fuer unbeaufsichtigte Installationen.
#   cp ibm.conf.example ibm.conf
# ============================================================================

# --- Anlage (MUSS angepasst werden) -----------------------------------------

# Wechselrichter-Typ. Entspricht einem Verzeichnis unter ../inverters/:
#   fronius              Fronius GEN24 (Fronius-Binding, Batterie-Actions)
#   fronius-snapinverter Fronius Symo Hybrid, SnapINverter-Generation
#                        (Modbus-Binding, SunSpec Model 124)
#   sigenergy            Sigenergy SigenStor (Modbus-Binding, proprietaere
#                        Registerkarte, Remote-EMS-Steuerung)
INVERTER_TYPE="fronius"

# UID des Wechselrichter-Things (bei den Modbus-Profilen: das SoC-Data-Thing
# des automatisch angelegten Baums, z. B. modbus:data:ibm:p124:soc bzw.
# modbus:data:ibm:sg:soc).
# Main UI -> Settings -> Things -> <Wechselrichter>
INVERTER_THING_UID="fronius:powerinverter:0cb68e8e38:273b6c06b4"

# Item mit dem Batterie-Ladestand (verknuepft mit dem soc-Channel).
# Wird NICHT vom Setup angelegt, sondern beim Verknuepfen des Channels
# in der Main UI erzeugt.
SOC_ITEM="Fronius_Symo_Inverter_Battery_State_of_Charge"

# Item mit der aktuellen Batterieleistung (+ entladen, - laden; verknuepft
# mit dem Channel powerflowchannelpakku). Zeigt auf der Overview-Seite die
# Entladeleistung der Batterie. Entsteht wie das SoC-Item beim Verknuepfen
# des Channels in der Main UI; leer = Platzhalter bleibt stehen und die
# Karte zeigt "-", bis ein Item mit dem Standardnamen existiert.
BATTERY_POWER_ITEM="Fronius_Symo_Inverter_Battery_Power"

# Item mit der aktuellen Netzleistung (+ Bezug, - Einspeisung; verknuepft
# mit dem Channel powerflowchannelpgrid). Zusammen mit der Batterieleistung
# berechnet die Regel ibm_netzeinspeisung.js daraus, wie viel der Entladung
# tatsaechlich ins Netz geht (Karte "Netzeinspeisung aus der Batterie").
# Leer = Regel wird nicht installiert, die Karte zeigt "-".
GRID_POWER_ITEM="Fronius_Symo_Inverter_Grid_Power"

# --- ischlstrom API ---------------------------------------------------------

IBM_API_BASE="https://ischlstrom.org"

# --- Zeitplaene (Quartz-Cron, 6 Felder: sek min std tag monat wochentag) -----

# Batteriesteuerung. Die Schedules gelten jeweils 5 Minuten, daher muss die
# Regel mindestens alle 5 Minuten laufen.
CRON_BATTERY="0 */5 * * * ?"

# Wolkenvorschau. Die Website aktualisiert die Wetterdaten stuendlich um :31.
CRON_CLOUD="0 40 * * * ?"

# Crossover-Zeiten. Die Materialized View wird nur monatlich aktualisiert,
# taeglich abholen genuegt daher voellig.
CRON_CROSSOVER="0 5 4 * * ?"

# Ladesperre-Fenster aus der Tagesprognose. Stuendlich, damit ein frueher
# API-Ausfall am selben Tag noch nachgeholt wird. Mit Status-Token (und
# DEFAULT_LADESPERRE_LOKAL nicht OFF) fragt die Anlage die individualisierte
# Token-API ab: der Server berechnet das Sperr-Ende dann je Anlage aus dem
# Erzeugungsprofil des Tages und den gepushten Schaetzwerten (Kapazitaet,
# Ladeleistung); ohne Token gilt das Community-Fenster.
CRON_LADESPERRE="0 50 * * * ?"

# Initialisierung der Konfigurations-Items (setzt nur NULL/UNDEF-Werte).
CRON_INIT="0 */10 * * * ?"

# Pause herunterzaehlen: IBM_PAUSE_TAGE (Unterseite "IBM pausieren") wird
# jede Nacht um 1 verringert; bei 0 arbeitet die Steuerung wieder.
CRON_PAUSE="0 30 0 * * ?"

# --- Startwerte der Konfigurations-Items ------------------------------------

# Ladestand, unterhalb dessen nicht mehr entladen wird (Prozent)
DEFAULT_MIN_BATTERY_CHARGE=20

# Entladeleistung in Watt
DEFAULT_MIN_DISCHARGE_W=1000
DEFAULT_MAX_DISCHARGE_W=3000

# Ladesperre am Vormittag: bei sonniger Prognose nicht laden, bis die
# Gemeinschaft deutlichen Ueberschuss hat. Das Zeitfenster kommt aus der
# Tagesprognose von ischlstrom.org (erster Sonnenschein bis in die
# Mittagsspitze; die Batterie laedt dann mitten im Ueberschuss).
DEFAULT_LADESPERRE_AKTIV=ON
DEFAULT_WOLKEN_SCHWELLE=75       # unter diesem Bewoelkungsgrad wird gesperrt

# Forcierte Entladung in der Nacht. Das Zeitfenster kommt aus den
# Crossover-Zeiten von ischlstrom.org; ohne plausible Zeiten wird nicht
# entladen. Zwei Schutzmechanismen sorgen dafuer, dass das Mitglied nach
# einer Einspeise-Nacht nicht selbst Strom zukaufen muss: bei bedeckter
# Vorschau (Wolken >= Schwelle) wird gar nicht eingespeist, und mit
# Status-Token begrenzt ein Nacht-Entladebudget der Token-API die
# Einspeisung auf das, was der Folgetag laut Prognose sicher wieder in die
# Batterie laedt (bei einer Schlechtwetterfront: nichts).
DEFAULT_ENTLADUNG_AKTIV=ON

# Entladeleistung automatisch an die Batteriegroesse anpassen. Die Steuerung
# schaetzt die Kapazitaet aus der Ladestandsaenderung waehrend der Entladung;
# solange keine belastbare Schaetzung vorliegt (oder bei OFF), gelten die
# Werte DEFAULT_MIN/MAX_DISCHARGE_W. Eine harte Obergrenze von 5000 W im
# Steuerungsskript wird in keinem Fall ueberschritten.
DEFAULT_DYNAMISCHE_LEISTUNG=ON

# Ladesperre-Ende selbst berechnen: aus der geschaetzten Batteriekapazitaet
# und der aus dem Ladestandsanstieg gelernten Ladeleistung errechnet die
# Steuerung, wann sie spaetestens zu laden beginnen muss, damit die Batterie
# eine Stunde vor dem abendlichen Crossover voll ist - und sperrt genau bis
# dahin (nie ueber 14:00 hinaus). Das passt das Sperr-Ende an die einzelne
# Anlage an: kleine Batterie mit starker PV sperrt laenger, grosse Batterie
# mit schwacher PV kuerzer oder gar nicht. Solange Kapazitaet oder
# Ladeleistung noch nicht belastbar geschaetzt sind (oder bei OFF), gilt
# das Server-Ende aus der Tagesprognose.
DEFAULT_LADESPERRE_LOKAL=ON

# --- Optionen ---------------------------------------------------------------

# Addons ueber addons.cfg installieren.
# ACHTUNG: siehe Warnung in README.md - auf 0 setzen, wenn die Addons bereits
# ueber die Main UI installiert wurden.
INSTALL_ADDONS=1

# Persistence (mapdb) einrichten, damit die Einstellungen einen Neustart
# ueberleben.
INSTALL_PERSISTENCE=1

# openHAB Cloud (myopenhab.org) einrichten: traegt das Addon 'openhabcloud'
# in addons.cfg ein (Kategorie misc); 07-myopenhab.sh zeigt danach UUID und
# Secret fuer die Registrierung des Kontos auf myopenhab.org an.
INSTALL_CLOUD=1

# Main-UI-Seiten (Overview + Unterseiten) per REST API installieren (braucht
# OH_API_TOKEN). Bestehende Seiten werden vorher nach /var/lib/openhab/ibm/
# gesichert.
INSTALL_OVERVIEW=1

# --- openHAB REST API -------------------------------------------------------

# API-Token eines Admin-Benutzers; gebraucht vom Netzwerk-Watchdog und von
# der Installation der Overview-Seite. Erzeugen in der Main UI: links unten
# auf den Benutzernamen klicken -> "Create new API token".
OH_API_TOKEN=""

# --- Netzwerk-Watchdog ------------------------------------------------------
# Teilt der Router dem Wechselrichter per DHCP eine neue IP zu, sucht der
# Watchdog das lokale Netz ab (Fronius Solar API), gleicht die Seriennummer
# ab und traegt die neue Adresse per REST API in das Bridge-Thing ein.
INSTALL_WATCHDOG=1

# UID des Things, das die Netzwerkadresse traegt - bei Fronius die BRIDGE,
# nicht der Wechselrichter selbst.
# Main UI -> Settings -> Things -> Fronius Bridge
INVERTER_HOST_THING_UID="fronius:bridge:0cb68e8e38"

# Fallback-Pruefung, falls das OFFLINE-Ereignis verpasst wurde (Quartz-Cron).
CRON_WATCHDOG="0 7/15 * * * ?"

# Fruehestens alle so viele Minuten wird das Netz erneut abgesucht.
WATCHDOG_COOLDOWN_MIN=10

# --- WireGuard-Fernwartung ---------------------------------------------------
# Ausgehender WireGuard-Tunnel zum Wartungsserver, damit die Anlage fuer
# Updates und Fehlersuche per SSH erreichbar bleibt. Der Pi baut die
# Verbindung selbst auf - am Router des Mitglieds ist nichts zu oeffnen,
# und durch den Tunnel laeuft nur das Wartungsnetz (siehe README).
INSTALL_WIREGUARD=1

# Tunnel-IP dieser Anlage. Vergibt der Wartungsserver - muss je Anlage
# eindeutig sein (Peer-Liste in dessen wg0.conf ist die Registry).
WG_ADDRESS="10.88.0.11"

# Gegenstelle (Host:Port).
WG_SERVER_ENDPOINT="s1.ischlstrom.org:51820"

# Public Key des Wartungsservers. Leer = wird von
# <IBM_API_BASE>/ibm/wg-server.pub geladen.
WG_SERVER_PUBLIC_KEY=""

# Benutzer fuer die SSH-Anmeldung durch den Tunnel (per Passwort - deshalb
# das Standardpasswort aendern lassen, siehe INSTALL_PASSWORD_CHANGE).
WG_SSH_USER="openhabian"

# --- Standardpasswoerter ------------------------------------------------------
# 10-change-passwords.sh aendert die Standardpasswoerter des Linux-Benutzers
# 'openhabian' (wird bei der Installation abgefragt bzw. IBM_NEW_PASSWORD;
# Samba wird mitgeaendert) und der Karaf-Konsole (wird zufaellig erzeugt und
# einmalig angezeigt). Passwoerter selbst stehen nie in dieser Datei.
INSTALL_PASSWORD_CHANGE=1
