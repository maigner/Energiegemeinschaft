# /etc/eegfaktura-import.env - wird von eegfaktura-import.service gelesen
# (root:root 0600). Normale EEG-Faktura-Anmeldung; Passwort ohne Doppelpunkt.
FAKTURA_USER=vorname.nachname@example.org
FAKTURA_PASSWORD=
RC_NUMBER=RC101533
# Gemeinschafts-ID (33 Zeichen), steht in EEG-Faktura unter Stammdaten
# und im Energy-Report auf dem Blatt Summary
EC_ID=AT00300000000RC101533000000968701
# DB ueber den Unix-Socket, OS-Benutzer eegimport -> DB-Rolle ischlstrom_middleware
# (peer-Auth mit pg_ident, setup-on-s1.sh); user= ist Pflicht, sonst nimmt
# libpq den OS-Benutzernamen als Rolle
EEG_DB_DSN=dbname=ischlstrom_middleware user=ischlstrom_middleware
