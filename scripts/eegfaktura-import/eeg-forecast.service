[Unit]
Description=Energieprognose neu rechnen und speichern
After=network-online.target postgresql.service eegfaktura-import.service
Wants=network-online.target

[Service]
Type=oneshot
User=eegimport
Group=eegimport
# DB-Rolle, falls eine DSN ohne user= kommt (libpq naehme sonst den OS-Benutzer)
Environment=PGUSER=ischlstrom_middleware
WorkingDirectory=/var/lib/eegfaktura-import/forecast
ExecStart=/usr/local/sbin/eeg-forecast.sh
# DB-Abfrage ueber 70 Mio. Zeilen plus Training
TimeoutStartSec=1h
Nice=10
